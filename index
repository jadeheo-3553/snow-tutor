function initStreak() {
  // 날짜가 바뀌면 todayGoals 초기화
  const lastGoalDate = localStorage.getItem('lastGoalDate') || '';
  if (lastGoalDate !== todayStr) {
    todayGoals = { translate: false, word: false, quiz: false, any: false };
    localStorage.setItem('todayGoals', JSON.stringify(todayGoals));
    localStorage.setItem('lastGoalDate', todayStr);
  }

  // 어제 학습했는지 체크해서 스트릭 연속 여부 판단
  if (streakData.lastDate !== todayStr) {
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    const yStr = yesterday.toLocaleDateString('ko-KR');
    if (streakData.lastDate !== yStr && streakData.lastDate !== '') {
      // 어제도 아니고 오늘도 아니면 스트릭 초기화
      streakData.days = 0;
    }
    streakData.todayDone = false;
    saveStreak();
  }
  renderHome();
}

function markGoalDone(type) {
  if (todayGoals[type]) return;
  todayGoals[type] = true;
  localStorage.setItem('todayGoals', JSON.stringify(todayGoals));

  // 모든 목표 완료 시 스트릭 증가
  const allDone = Object.values(todayGoals).every(v => v);
  if (allDone && !streakData.todayDone) {
    streakData.days += 1;
    streakData.best = Math.max(streakData.best, streakData.days);
    streakData.lastDate = todayStr;
    streakData.todayDone = true;
    saveStreak();
    showToast('🔥 오늘 목표 완료! 스트릭 ' + streakData.days + '일!');
  }
  renderHome();
}

function saveStreak() {
  localStorage.setItem('streakData', JSON.stringify(streakData));
}

function renderHome() {
  // 인사말
  const hour = new Date().getHours();
