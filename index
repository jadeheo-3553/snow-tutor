//  REVIEW (망각곡선 복습)
// ══════════════════════════════════════
// 에빙하우스 망각곡선: 저장 후 1일, 3일, 7일, 14일, 30일 복습
const REVIEW_INTERVALS = [1, 3, 7, 14, 30];

function getReviewQueue() {
  const now = Date.now();
  const msDay = 86400000;
  return snowStorage.sentence.filter(s => {
    if (!s.savedAt) return false;
    const reviewData = s.reviewData || { level: 0, lastReview: s.savedAt };
    const level = reviewData.level || 0;
    if (level >= REVIEW_INTERVALS.length) return false; // 완전 마스터
    const nextInterval = REVIEW_INTERVALS[level] * msDay;
    return (now - reviewData.lastReview) >= nextInterval;
  });
}

function renderReview() {
  reviewQueue = getReviewQueue();
  reviewIdx = 0;
  showNextReview();
}

function showNextReview() {
  const panel = document.getElementById('reviewPanel');
  const doneMsg = document.getElementById('reviewDoneMsg');
  if (!panel) return;

  if (reviewQueue.length === 0 || reviewIdx >= reviewQueue.length) {
    panel.style.display = 'none';
    if (doneMsg) doneMsg.style.display = 'block';
    return;
  }

  doneMsg && (doneMsg.style.display = 'none');
  panel.style.display = 'block';
  reviewFlipped = false;

  const item = reviewQueue[reviewIdx];
  const level = (item.reviewData && item.reviewData.level) || 0;
  const nextLevel = Math.min(level + 1, REVIEW_INTERVALS.length - 1);
  const labelText = ['첫 복습', '2회차', '3회차', '4회차', '마지막 복습'][level] || '복습';
  const remaining = reviewQueue.length - reviewIdx;

  panel.innerHTML = `
    <div style="text-align:center; font-size:12px; color:var(--text-muted); margin-bottom:12px;">
      남은 복습 <strong style="color:var(--accent);">${remaining}</strong>개
    </div>
    <div class="review-card">
      <div class="review-badge">${labelText}</div>
      <div class="review-q">🇰🇷 이 문장을 영어로 말할 수 있나요?</div>
      <div style="font-size:18px; font-weight:700; text-align:center; color:var(--text); margin-bottom:16px; padding:12px; background:var(--surface2); border-radius:12px;">
        ${item.kor || ''}
      </div>
      <div id="reviewAnswerWrap" style="display:none;">
        <div class="review-answer" onclick="speakText('${(item.eng||'').replace(/'/g,"\\'")}', 0.9)">
          ${item.eng || ''} 🔊
        </div>
        <div style="font-size:11px; color:var(--text-muted); text-align:center; margin-bottom:12px;">탭하면 발음을 들을 수 있어요</div>
        <div class="review-btns">
          <button class="btn-review-ok" onclick="reviewResult(true)">✅ 기억했어요!</button>
          <button class="btn-review-again" onclick="reviewResult(false)">🔄 다시 볼게요</button>
        </div>
      </div>
      <button class="btn-primary" id="reviewFlipBtn" onclick="flipReview()" style="margin-bottom:0;">
        👀 정답 보기
      </button>
    </div>
  `;
}

function flipReview() {
  document.getElementById('reviewAnswerWrap').style.display = 'block';
  document.getElementById('reviewFlipBtn').style.display = 'none';
  reviewFlipped = true;
  const item = reviewQueue[reviewIdx];
  speakText(item.eng, 0.9);
}

function reviewResult(correct) {
  const item = reviewQueue[reviewIdx];
  const sentIdx = snowStorage.sentence.findIndex(s => s.eng === item.eng && s.kor === item.kor);
  if (sentIdx !== -1) {
    const current = snowStorage.sentence[sentIdx];
    const level = (current.reviewData && current.reviewData.level) || 0;
    snowStorage.sentence[sentIdx].reviewData = {
      level: correct ? Math.min(level + 1, REVIEW_INTERVALS.length) : Math.max(0, level - 1),
      lastReview: Date.now()
    };
    saveStorage();
  }
  reviewIdx++;
  showNextReview();
}

