  if (!currentWordData) return;
  if (!masteredWords.includes(currentWordData.word)) {
    masteredWords.push(currentWordData.word);
    localStorage.setItem('masteredWords', JSON.stringify(masteredWords));
    snowStorage.word.unshift({ word: currentWordData.word, mean: currentWordData.mean });
    saveStorage();
    showToast("'"+currentWordData.word+"' 마스터! ✅");
  }
  updateSidebarStats();
  getNextWord();
}

