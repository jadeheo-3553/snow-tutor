  document.getElementById('transResult').style.display = 'block';
  document.getElementById('mainContent').scrollTop = 0;
  speakText(res.eng, 0.9);

  // 목표 달성 처리
  markGoalDone('translate');
}

function checkQuizAns(chosen, correct) {
  document.querySelectorAll('.quiz-option').forEach((el, i) => {
    el.onclick = null;
    if (i === correct) el.classList.add('correct');
    else if (i === chosen && chosen !== correct) el.classList.add('wrong');
  });
}

function saveSentence() {
  if (!currentEngSentence) return;
  snowStorage.sentence.unshift({
