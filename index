<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SNOW AI 영어 튜터</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0f0f14;
  --surface: #1a1a24;
  --surface2: #22222f;
  --border: rgba(255,255,255,0.08);
  --text: #f0f0f5;
  --text-muted: #888899;
  --accent: #7c6ff7;
  --accent2: #4ecdc4;
  --accent3: #ff6b9d;
  --gold: #f5c842;
  --green: #56d364;
  --card-shadow: 0 4px 24px rgba(0,0,0,0.4);
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body {
  font-family: 'Plus Jakarta Sans', 'Noto Sans KR', sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100dvh;
  overflow: hidden;
  display: flex;
  justify-content: center;
}

/* ── APP SHELL ── */
.app {
  width: 100%;
  max-width: 430px;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: var(--bg);
}

/* ── HEADER ── */
.app-header {
  flex-shrink: 0;
  padding: 14px 18px 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  position: relative;
  z-index: 10;
}
.app-logo {
  font-family: 'DM Serif Display', serif;
  font-size: 20px;
  letter-spacing: 1px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.header-btn {
  width: 38px; height: 38px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  font-size: 16px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}

/* ── BOTTOM NAV BAR ── */
.nav-bar {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 430px;
  display: flex;
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 5px 2px calc(5px + env(safe-area-inset-bottom));
  z-index: 100;
  overflow-x: scroll;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
  gap: 0px;
  -webkit-overflow-scrolling: touch;
  user-select: none;
  cursor: grab;
}
.nav-bar.dragging { cursor: grabbing; }
.nav-bar::-webkit-scrollbar { display: none; }
.nav-item {
  flex: 0 0 auto;
  width: 58px;
  padding: 5px 2px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-size: 9px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.2s, color 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}
.nav-item .nav-icon { font-size: 18px; line-height: 1; }
.nav-item.active {
  color: var(--accent);
  background: rgba(124,111,247,0.12);
}
.nav-item.active .nav-icon { filter: drop-shadow(0 0 6px rgba(124,111,247,0.7)); }

/* ── CONTENT ── */
.content {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0 16px 130px;
  scroll-behavior: smooth;
}
.tab-panel { display: none; }
.tab-panel.active { display: block; animation: fadeUp 0.3s ease; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* ── CARDS ── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: var(--card-shadow);
}
.card-accent-left { border-left: 4px solid var(--accent); }
.card-accent-green { border-left: 4px solid var(--green); }
.card-accent-gold { border-left: 4px solid var(--gold); }

/* ── INPUTS ── */
.input-field {
  width: 100%;
  padding: 14px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--text);
  font-size: 15px;
  font-family: inherit;
  outline: none;
  transition: border 0.2s;
  margin-bottom: 12px;
}
.input-field:focus { border-color: var(--accent); }
.input-field::placeholder { color: var(--text-muted); }

textarea.input-field { height: 130px; resize: none; line-height: 1.6; }

/* ── BUTTONS ── */
.btn-primary {
  width: 100%;
  padding: 15px;
  background: linear-gradient(135deg, var(--accent), #5d56d4);
  border: none;
  border-radius: 14px;
  color: white;
  font-size: 15px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(124,111,247,0.4);
  transition: all 0.2s;
  margin-bottom: 12px;
}
.btn-primary:active { transform: scale(0.98); }

.btn-green {
  width: 100%;
  padding: 15px;
  background: linear-gradient(135deg, #2dba72, #1a9d5f);
  border: none;
  border-radius: 14px;
  color: white;
  font-size: 15px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(45,186,114,0.3);
  transition: all 0.2s;
  margin-bottom: 12px;
}

.btn-ghost {
  padding: 9px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-ghost:hover, .btn-ghost.active-speed { background: var(--accent); color: white; border-color: var(--accent); }

.btn-save {
  width: 100%;
  padding: 13px;
  background: transparent;
  border: 1px solid var(--accent3);
  border-radius: 12px;
  color: var(--accent3);
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
  margin-top: 6px;
}
.btn-save:active { background: var(--accent3); color: white; }

/* ── TRANSLATE RESULT ── */
.eng-sentence {
  font-family: 'DM Serif Display', serif;
  font-size: 26px;
  line-height: 1.4;
  color: var(--text);
  word-break: break-word;
}
.word-tap {
  cursor: pointer;
  position: relative;
  display: inline-block;
  border-bottom: 2px solid rgba(124,111,247,0.5);
  transition: all 0.15s;
  color: #c8c5ff;
}
.word-tap:active { color: var(--accent); border-bottom-color: var(--accent); }

.speed-row { display: flex; gap: 8px; margin-top: 14px; }
.speed-row .btn-ghost { flex: 1; text-align: center; }

.chunk-box {
  background: var(--surface2);
  border-radius: 12px;
  padding: 14px;
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.8;
  margin-top: 14px;
}
.chunk-sep { color: var(--accent); margin: 0 4px; }

.section-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 10px;
}

.guide-card {
  background: var(--surface2);
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 10px;
  border-left: 3px solid var(--accent3);
}
.guide-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--accent3);
  margin-bottom: 6px;
}
.guide-desc { font-size: 13px; color: #ccc; line-height: 1.6; }

.example-row {
  padding: 11px 0;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}
.example-row:last-child { border-bottom: none; }
.example-eng { font-size: 14px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 6px; }
.example-kor { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.speak-icon { font-size: 12px; color: var(--accent2); }

.badge {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.badge-basic { background: rgba(86,211,100,0.15); color: var(--green); }
.badge-up { background: rgba(124,111,247,0.15); color: var(--accent); }

.quiz-option {
  padding: 14px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 12px;
  margin-bottom: 8px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.15s;
  display: flex; align-items: center; gap: 10px;
}
.quiz-option:active { transform: scale(0.99); }
.quiz-option.correct { border-color: var(--green); background: rgba(86,211,100,0.1); color: var(--green); }
.quiz-option.wrong { border-color: var(--accent3); background: rgba(255,107,157,0.1); color: var(--accent3); }
.quiz-option-num {
  width: 24px; height: 24px;
  background: var(--border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; flex-shrink: 0;
}

/* ── DIARY ── */
.diary-corrected {
  font-family: 'DM Serif Display', serif;
  font-size: 18px;
  line-height: 1.8;
  color: var(--text);
}
.diary-corrected .word-tap { font-size: 18px; }

/* ── SNAP (PHOTO) ── */
.upload-area {
  background: var(--surface2);
  border: 2px dashed var(--border);
  border-radius: 18px;
  padding: 36px 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  margin-bottom: 12px;
}
.upload-area.has-image { padding: 0; border-style: solid; border-color: var(--accent); overflow: hidden; }
.upload-area img { width: 100%; border-radius: 16px; display: block; }
.upload-icon { font-size: 40px; margin-bottom: 10px; }
.upload-text { color: var(--text-muted); font-size: 14px; }

.snap-word-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}
.snap-word-row:last-child { border-bottom: none; }
.snap-word-eng { font-size: 16px; font-weight: 700; color: var(--text); }
.snap-word-kor { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
.snap-speak { color: var(--accent2); font-size: 18px; }

/* ── WORDBOOK ── */
.level-selector {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}
.level-btn {
  flex: 1;
  padding: 10px 6px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 12px;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  text-align: center;
  transition: all 0.2s;
}
.level-btn.active { background: var(--accent); color: white; border-color: var(--accent); }

.word-hero {
  text-align: center;
  padding: 24px 0 16px;
}
.word-main {
  font-family: 'DM Serif Display', serif;
  font-size: 52px;
  color: var(--text);
  cursor: pointer;
  transition: color 0.2s;
}
.word-main:active { color: var(--accent); }
.word-mean {
  font-size: 20px;
  color: var(--text-muted);
  margin-top: 8px;
}
.speak-big { font-size: 22px; color: var(--accent2); margin-left: 8px; cursor: pointer; }

.step-card {
  background: var(--surface2);
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 10px;
}
.step-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 8px;
}
.step1 .step-title { color: var(--green); }
.step2 .step-title { color: var(--gold); }
.step3 .step-title { color: var(--accent3); }
.step-eng { font-size: 14px; font-weight: 600; color: var(--text); cursor: pointer; }
.step-kor { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

.word-actions { display: flex; gap: 8px; margin-top: 12px; }
.word-actions button { flex: 1; padding: 12px; border-radius: 12px; border: none; font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
.btn-know { background: var(--green); color: #000; }
.btn-next { background: var(--accent); color: white; }

.mastered-count {
  text-align: center;
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 10px;
}

/* ── QUIZ ── */
.quiz-big-q {
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.5;
  padding: 24px 10px;
  color: var(--text);
}

/* ── SIDEBAR ── */
.sidebar-overlay {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 900;
  backdrop-filter: blur(4px);
}
.sidebar-overlay.open { display: block; }

.sidebar {
  position: fixed;
  left: -340px;
  top: 0; bottom: 0;
  width: 300px;
  background: var(--surface);
  border-right: 1px solid var(--border);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  transition: left 0.3s cubic-bezier(0.4,0,0.2,1);
  overflow: hidden;
}
.sidebar.open { left: 0; }

.sidebar-header {
  padding: 20px 18px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.sidebar-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}
.sidebar-close {
  width: 32px; height: 32px;
  background: var(--surface2);
  border: none;
  border-radius: 8px;
  color: var(--text-muted);
  font-size: 16px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}

.sidebar-search {
  padding: 12px 16px;
  flex-shrink: 0;
}
.sidebar-search input {
  width: 100%;
  padding: 10px 14px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  font-size: 13px;
  font-family: inherit;
  outline: none;
}
.sidebar-search input::placeholder { color: var(--text-muted); }

.sidebar-tabs {
  display: flex;
  padding: 0 16px;
  gap: 8px;
  flex-shrink: 0;
  margin-bottom: 12px;
}
.sidebar-tab {
  flex: 1;
  padding: 8px;
  border-radius: 8px;
  border: none;
  background: var(--surface2);
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
}
.sidebar-tab.active { background: var(--accent); color: white; }

.sidebar-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 16px 20px;
}
.save-item {
  background: var(--surface2);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  position: relative;
  cursor: pointer;
  transition: all 0.15s;
}
.save-item:active { background: #2a2a38; }
.save-item-kor { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
.save-item-eng { font-size: 12px; color: var(--text-muted); }
.save-del { position: absolute; top: 10px; right: 10px; background: none; border: none; color: var(--accent3); font-size: 16px; cursor: pointer; padding: 4px; }

.sidebar-stats {
  padding: 14px 16px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 10px;
  flex-shrink: 0;
}
.stat-box {
  flex: 1;
  background: var(--surface2);
  border-radius: 10px;
  padding: 10px;
  text-align: center;
}
.stat-num { font-size: 20px; font-weight: 700; color: var(--accent); }
.stat-label { font-size: 10px; color: var(--text-muted); margin-top: 2px; }

/* ── MODAL ── */
.modal-bg {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.8);
  z-index: 2000;
  align-items: flex-end;
  justify-content: center;
  backdrop-filter: blur(6px);
}
.modal-bg.open { display: flex; animation: fadeIn 0.2s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal-sheet {
  width: 100%;
  max-width: 430px;
  background: var(--surface);
  border-radius: 24px 24px 0 0;
  padding: 20px 20px 36px;
  animation: slideUp 0.3s cubic-bezier(0.4,0,0.2,1);
  max-height: 85dvh;
  overflow-y: auto;
}
@keyframes slideUp { from { transform: translateY(60px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.modal-handle { width: 40px; height: 4px; background: var(--border); border-radius: 2px; margin: 0 auto 18px; }
.modal-word { font-family: 'DM Serif Display', serif; font-size: 32px; text-align: center; color: var(--text); margin-bottom: 4px; cursor: pointer; }
.modal-mean { text-align: center; font-size: 16px; color: var(--text-muted); margin-bottom: 6px; }
.modal-tip { font-size: 13px; color: #aaa; line-height: 1.6; margin-bottom: 16px; padding: 12px; background: var(--surface2); border-radius: 10px; }
.modal-ex { padding: 11px 14px; background: var(--surface2); border-radius: 10px; margin-bottom: 8px; cursor: pointer; }
.modal-ex-eng { font-size: 13px; font-weight: 600; color: var(--accent2); }
.modal-ex-kor { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.modal-actions { display: flex; gap: 8px; margin-top: 14px; }
.modal-btn { flex: 1; padding: 13px; border-radius: 12px; border: none; font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
.modal-btn-save { background: var(--accent); color: white; }
.modal-btn-dict { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
.modal-btn-close { background: var(--surface2); color: var(--text-muted); border: 1px solid var(--border); }

/* ── LOADING ── */
.loading-bar {
  display: none;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent));
  background-size: 200%;
  border-radius: 2px;
  margin-bottom: 16px;
  animation: shimmer 1.5s infinite;
}
.loading-bar.active { display: block; }
@keyframes shimmer { 0% { background-position: 0%; } 100% { background-position: 200%; } }

.loading-text {
  text-align: center;
  color: var(--text-muted);
  font-size: 13px;
  padding: 30px 0;
  display: none;
}
.loading-text.active { display: block; }

/* ── EMPTY STATES ── */
.empty-state {
  text-align: center;
  padding: 48px 20px;
  color: var(--text-muted);
}
.empty-icon { font-size: 48px; margin-bottom: 12px; opacity: 0.5; }
.empty-text { font-size: 14px; line-height: 1.6; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

/* ── SECTION HEADERS ── */
.section-head {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin: 20px 0 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-head::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* ── EXPRESSION PILLS ── */
.expr-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.expr-pill {
  padding: 7px 12px;
  background: var(--surface2);
  border-radius: 20px;
  font-size: 12px;
  color: var(--text);
  cursor: pointer;
  border: 1px solid var(--border);
  transition: all 0.15s;
}
.expr-pill:active { background: var(--accent); border-color: var(--accent); }

/* ── DIARY INPUT HELPER ── */
.input-hint {
  font-size: 12px;
  color: #b0b0c8;
  margin-top: -4px;
  margin-bottom: 12px;
  padding: 6px 10px;
  background: rgba(124,111,247,0.1);
  border-radius: 8px;
  border-left: 3px solid var(--accent);
}

/* ── PROGRESS BAR ── */
.progress-wrap { background: var(--surface2); border-radius: 4px; height: 6px; overflow: hidden; margin: 8px 0 4px; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 4px; transition: width 0.5s; }

/* ── HOME DASHBOARD ── */
.home-greeting {
  padding: 18px 0 6px;
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}
.home-greeting span { color: var(--accent); }

.streak-card {
  background: linear-gradient(135deg, #1e1b3a, #2a1f4a);
  border: 1px solid rgba(124,111,247,0.3);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 14px;
