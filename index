<script>
// ══════════════════════════════════════
//  CONFIG  (API 키를 여기에 입력하세요)
// ══════════════════════════════════════
const API_KEY = "AIzaSyCoaWLFf7-uhlC2WhWR1xDLi1DaoKVWWTE";
const MODEL  = "gemini-3-flash-preview"; // ✅ 올바른 모델명 유지

// ══════════════════════════════════════
//  STATE
// ══════════════════════════════════════
let currentEngSentence = "";
let currentKorInput    = "";
let currentWordData    = null;
let currentLevel       = "beginner";
let currentSaveTab     = "sentence";
let seenWords          = JSON.parse(localStorage.getItem('seenWords') || '[]');
let masteredWords      = JSON.parse(localStorage.getItem('masteredWords') || '[]');
let snowStorage        = JSON.parse(localStorage.getItem('snowStorage') || '{"sentence":[],"word":[]}');
let currentWordModal   = null;
let snapBase64         = null;
let snapMimeType       = "";
let quizDifficulty     = "easy";
let currentMovieGenre  = "thriller";
let currentMovieGenreKor = "스릴러";

// ── 스트릭 & 목표 ──
let streakData = JSON.parse(localStorage.getItem('streakData') || '{"days":0,"best":0,"lastDate":"","todayDone":false}');
let todayGoals = JSON.parse(localStorage.getItem('todayGoals') || '{"translate":false,"word":false,"quiz":false,"any":false}');
const todayStr = new Date().toLocaleDateString('ko-KR');

// ── 복습 & 통계 ──
let reviewQueue = [];
let reviewIdx = 0;
let reviewFlipped = false;
let tabUsage = JSON.parse(localStorage.getItem('tabUsage') || '{}');
let learningLog = JSON.parse(localStorage.getItem('learningLog') || '{}');

// ══════════════════════════════════════
//  GEMINI API
// ══════════════════════════════════════
async function callGemini(prompt, imageData = null) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent?key=${API_KEY}`;
  const parts = [];
  if (imageData) {
    parts.push({ inlineData: { mimeType: imageData.mime, data: imageData.b64 } });
  }
  parts.push({ text: prompt });
  const body = { contents: [{ parts }] };
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  const data = await res.json();
  if (!data.candidates || !data.candidates[0]) throw new Error("No response");
  let text = data.candidates[0].content.parts[0].text;
  text = text.replace(/```json|```/g, '').trim();
  const match = text.match(/\{[\s\S]*\}/);
  if (!match) throw new Error("No JSON found");
  return JSON.parse(match[0]);
}

// ══════════════════════════════════════
//  SPEECH
// ══════════════════════════════════════
function speakText(t, rate = 0.9) {
  if (!t) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(t.replace(/\(.*?\)/g,'').trim());
  u.lang = 'en-US'; u.rate = rate;
  window.speechSynthesis.speak(u);
}
function speakCurrentSpeed(rate) {
  if (currentEngSentence) speakText(currentEngSentence, rate);
}

// ══════════════════════════════════════
//  TAB NAVIGATION
// ══════════════════════════════════════
function showTab(id) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  document.getElementById('nav-' + id).classList.add('active');
  document.getElementById('mainContent').scrollTop = 0;
  logTabUsage(id);
  if (id === 'stats') renderStats();
  if (id === 'review') renderReview();
  if (id === 'home') renderHome();
}

// ══════════════════════════════════════
//  TRANSLATE
// ══════════════════════════════════════
async function runTranslate() {
  const input = document.getElementById('transInput').value.trim();
  if (!input) { alert("문장을 입력하세요!"); return; }
  currentKorInput = input;

  setLoading('trans', true);
  document.getElementById('transResult').style.display = 'none';

  const prompt = `
영한 AI 튜터. 한글 입력: "${input}"
아래 JSON을 정확히 반환해. 절대 JSON 외 다른 텍스트 없이.
{
  "eng": "영어 번역 문장",
  "chunks": "단어/뜻/단어/뜻 형식으로 직독직해 (슬래시로 구분)",
  "dictionary": [{"word":"단어","mean":"뜻","tip":"초보자를 위한 상세 설명 (문법용어 한글+영어 병기)","exs":["예문 (해석)"]}],
  "guides": [{"title":"문법 포인트 (영어명)","desc":"초보자도 이해하는 쉬운 설명, 예시 포함"}],
  "samples_basic": ["기본 예문1 (해석)", "기본 예문2 (해석)", "기본 예문3 (해석)"],
  "samples_up": ["심화 예문1 (해석)", "심화 예문2 (해석)"],
  "quiz": {"q":"객관식 문제 (한글)", "opts": ["보기1","보기2","보기3","보기4"], "ans": 정답_인덱스_숫자}
}
dictionary에는 번역된 영어 문장의 '모든' 단어를 포함할 것.
guides는 초보자에게 꼭 필요한 문법 설명 2~3개.
quiz는 방금 배운 문법/단어를 활용한 문제.
`;

  try {
    const res = await callGemini(prompt);
    renderTranslate(res);
  } catch(e) {
    alert("오류가 발생했어요. 다시 시도해주세요.\n(" + e.message + ")");
  } finally {
    setLoading('trans', false);
  }
}

function revealStep(stepNum) {
  document.getElementById('stepBlock' + stepNum).classList.add('visible');
  // 이전 버튼 숨기기
  const prevBtn = document.getElementById('revealBtn' + stepNum);
  if (prevBtn) prevBtn.classList.add('hidden-btn');
  // 해당 블록으로 스크롤
  setTimeout(() => {
    document.getElementById('stepBlock' + stepNum).scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
}

function renderTranslate(res) {
  currentEngSentence = res.eng;

  // 모든 step 블록 초기화
  for (let i = 2; i <= 5; i++) {
    const b = document.getElementById('stepBlock' + i);
    if (b) b.classList.remove('visible');
    const btn = document.getElementById('revealBtn' + (i));
    if (btn) btn.classList.remove('hidden-btn');
  }
  document.getElementById('stepBlock1').classList.add('visible');

  // ① 번역 + 직독직해
  const wordHTML = res.eng.split(' ').map(w => {
    const clean = w.toLowerCase().replace(/[.,!?;:']/g, '');
    const found = res.dictionary && res.dictionary.find(d => d.word.toLowerCase() === clean);
    const dData = found || { word: clean, mean: '탭하면 사전 확인', tip: '구글 사전에서 확인해보세요.', exs: [] };
    return `<span class="word-tap" onclick='openWordModal(${JSON.stringify(dData)})'>${w}</span>`;
  }).join(' ');
  document.getElementById('engSentence').innerHTML = wordHTML;
  document.getElementById('sayItSentence').textContent = res.eng;

  // 직독직해
  const parts = (res.chunks || '').split('/');
