  });
  sHTML += `<div style="margin:14px 0 12px;"><span class="badge badge-up">🚀 Step Up</span><span style="font-size:12px; color:var(--text-muted); margin-left:6px;">심화 예문</span></div>`;
  (res.samples_up || []).forEach(s => {
    const eng = s.split('(')[0].trim();
    const kor = s.includes('(') ? s.slice(s.indexOf('(')+1, s.lastIndexOf(')')) : '';
    sHTML += `<div class="example-row" onclick="speakText('${eng.replace(/'/g,"\\'")}', 0.8)">
