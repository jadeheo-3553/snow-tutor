function initNavDrag() {
  const nav = document.querySelector('.nav-bar');
  if (!nav) return;
  let isDown = false, startX = 0, scrollLeft = 0, moved = false;

  // 마우스 드래그
  nav.addEventListener('mousedown', e => {
    isDown = true; moved = false;
    nav.classList.add('dragging');
    startX = e.pageX - nav.offsetLeft;
    scrollLeft = nav.scrollLeft;
  });
  nav.addEventListener('mouseleave', () => { isDown = false; nav.classList.remove('dragging'); });
  nav.addEventListener('mouseup', () => { isDown = false; nav.classList.remove('dragging'); });
  nav.addEventListener('mousemove', e => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - nav.offsetLeft;
    const walk = (x - startX) * 1.5;
    if (Math.abs(walk) > 4) moved = true;
    nav.scrollLeft = scrollLeft - walk;
  });

  // 탭 클릭 시 드래그 중이면 무시 (버튼 이벤트 보호)
  nav.querySelectorAll('.nav-item').forEach(btn => {
    btn.addEventListener('click', e => { if (moved) e.stopPropagation(); });
  });
}

// ══════════════════════════════════════
//  SPEECH RECOGNITION (따라말하기 채점)
// ══════════════════════════════════════
let recog = null;
let isRecording = false;

function toggleSpeechRecog() {
  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    showToast('❌ 이 브라우저는 음성 인식을 지원하지 않아요 (Chrome 권장)');
    return;
  }
  if (isRecording) {
    stopRecording();
  } else {
    startRecording();
  }
}

function startRecording() {
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  recog = new SpeechRec();
  recog.lang = 'en-US';
  recog.interimResults = true;
  recog.continuous = false;
  recog.maxAlternatives = 1;

  const btn = document.getElementById('micBtn');
  const box = document.getElementById('transcriptBox');
  const scoreArea = document.getElementById('scoreArea');

  btn.innerHTML = '⏹ 말하는 중... (다시 누르면 중지)';
  btn.classList.add('recording');
  box.style.display = 'block';
  box.textContent = '🎤 듣고 있어요... 지금 말해보세요!';
  scoreArea.style.display = 'none';
  isRecording = true;

  let finalTranscript = '';

  recog.onstart = () => {
    box.textContent = '🎤 듣고 있어요... 지금 말해보세요!';
  };

  recog.onresult = e => {
    let interim = '';
    finalTranscript = '';
    for (let i = 0; i < e.results.length; i++) {
      if (e.results[i].isFinal) {
        finalTranscript += e.results[i][0].transcript;
      } else {
        interim += e.results[i][0].transcript;
      }
    }
    box.textContent = finalTranscript || interim || '...';
  };

  recog.onend = () => {
    isRecording = false;
    btn.innerHTML = '🎤 다시 따라 말하기';
    btn.classList.remove('recording');
    const result = finalTranscript || box.textContent;
    if (result && result !== '🎤 듣고 있어요... 지금 말해보세요!' && result !== '...') {
      scorePronunciation(currentEngSentence, result);
    } else {
      box.textContent = '아무 소리도 인식되지 않았어요. 다시 눌러서 말해보세요!';
    }
  };

  recog.onerror = e => {
    isRecording = false;
    btn.innerHTML = '🎤 따라 말하고 채점받기';
    btn.classList.remove('recording');
    const errMap = {
      'not-allowed': '❌ 마이크 권한이 거부됐어요.\n브라우저 주소창 왼쪽 🔒 아이콘을 눌러서 마이크 권한을 허용해주세요.',
      'no-speech': '🔇 소리가 감지되지 않았어요. 마이크에 가까이 대고 다시 시도해보세요.',
      'audio-capture': '🎙️ 마이크를 찾을 수 없어요. 마이크가 연결되어 있는지 확인해주세요.',
      'network': '🌐 네트워크 오류예요. 인터넷 연결을 확인해주세요.',
      'aborted': '중단됐어요. 다시 시도해보세요.',
    };
    box.style.display = 'block';
    box.textContent = errMap[e.error] || `오류: ${e.error} — 다시 시도해보세요.`;
  };

  try {
    recog.start();
  } catch(e) {
    isRecording = false;
    btn.innerHTML = '🎤 따라 말하고 채점받기';
    btn.classList.remove('recording');
    box.textContent = '음성 인식 시작 실패: ' + e.message;
  }
}

function stopRecording() {
  if (recog) recog.stop();
}

function scorePronunciation(original, spoken) {
  const normalize = s => s.toLowerCase().replace(/[.,!?;:'"]/g, '').trim();
  const origWords = normalize(original).split(/\s+/);
  const spokenWords = normalize(spoken).split(/\s+/);

  let matched = 0;
  const usedIdx = new Set();
  const resultWords = origWords.map(ow => {
    const idx = spokenWords.findIndex((sw, i) => !usedIdx.has(i) && sw === ow);
    if (idx !== -1) { usedIdx.add(idx); matched++; return `<span class="diff-match">${ow}</span>`; }
    return `<span class="diff-miss">${ow}</span>`;
  });

  const score = Math.round((matched / origWords.length) * 100);
  const color = score >= 80 ? 'var(--green)' : score >= 50 ? 'var(--gold)' : 'var(--accent3)';
  const comments = {
    100: '🏆 완벽해요! 발음이 정확해요!',
    80:  '🎉 아주 잘했어요! 거의 완벽!',
    60:  '👍 잘하고 있어요! 조금 더 연습해봐요.',
    40:  '💪 괜찮아요! 천천히 다시 해봐요.',
    0:   '😊 처음엔 다 어려워요. 한 단어씩 해봐요!'
  };
  const commentKey = [100,80,60,40,0].find(k => score >= k);

  document.getElementById('transcriptBox').innerHTML =
    `<div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">내가 말한 것:</div>` +
    `<div style="color:var(--text);margin-bottom:8px;">${spoken}</div>` +
    `<div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">원문 대조:</div>` +
    resultWords.join(' ');

  const scoreArea = document.getElementById('scoreArea');
  scoreArea.style.display = 'block';
  document.getElementById('scoreBarFill').style.width = score + '%';
  document.getElementById('scoreBarFill').style.background = `linear-gradient(90deg, ${color}, ${color})`;
  document.getElementById('scoreNum').style.color = color;
  document.getElementById('scoreNum').textContent = score + '%';
  document.getElementById('scoreComment').textContent = comments[commentKey];
}

