function logTabUsage(tabId) {
  tabUsage[tabId] = (tabUsage[tabId] || 0) + 1;
  localStorage.setItem('tabUsage', JSON.stringify(tabUsage));
  const today = new Date().toLocaleDateString('ko-KR');
  learningLog[today] = (learningLog[today] || 0) + 1;
  localStorage.setItem('learningLog', JSON.stringify(learningLog));
}

function renderStats() {
  const el = id => document.getElementById(id);
  if (!el('statTotalDays')) return;

  const totalDays = Object.keys(learningLog).length;
  el('statTotalDays').textContent = totalDays;
  el('statTotalSent2').textContent = snowStorage.sentence.length;
  el('statTotalWord2').textContent = snowStorage.word.length;
  el('statStreak').textContent = streakData.days;
  el('statBest').textContent = streakData.best;
  el('statMasteredCount').textContent = masteredWords.length;

  // 마스터 단어 태그
  const mwEl = el('masteredWordList');
  if (mwEl) {
    mwEl.innerHTML = masteredWords.length === 0
      ? '<div style="font-size:13px;color:var(--text-muted);">아직 마스터한 단어가 없어요. 단어장에서 학습해보세요!</div>'
      : masteredWords.map(w => `<span style="padding:5px 10px;background:rgba(86,211,100,0.15);border:1px solid var(--green);border-radius:20px;font-size:12px;color:var(--green);font-weight:600;">${w}</span>`).join('');
  }

  // 탭별 사용 차트
  const chartEl = el('tabUsageChart');
  if (chartEl) {
    const tabNames = { home:'🏠홈', translate:'✨분석', diary:'✍️일기', snap:'📸찰칵', words:'📖단어장', quiz:'⚡퀴즈', movie:'🎬영화', lyrics:'🎵가사', review:'🔁복습' };
    const maxVal = Math.max(1, ...Object.values(tabUsage));
    chartEl.innerHTML = Object.entries(tabNames).map(([k, name]) => {
      const val = tabUsage[k] || 0;
      const pct = Math.round((val / maxVal) * 100);
      const color = k === 'translate' ? 'var(--accent)' : k === 'words' ? 'var(--accent2)' : k === 'quiz' ? 'var(--gold)' : 'var(--accent3)';
      return `<div class="bar-chart-row">
        <div class="bar-label">${name}</div>
        <div class="bar-bg"><div class="bar-fill" style="width:${pct}%;background:${color};"></div></div>
        <div class="bar-val">${val}</div>
      </div>`;
    }).join('');
  }

  // 30일 히트맵
  const hmEl = el('heatmapArea');
  if (hmEl) {
    const cells = [];
    for (let i = 29; i >= 0; i--) {
      const d = new Date(); d.setDate(d.getDate() - i);
      const key = d.toLocaleDateString('ko-KR');
      const cnt = learningLog[key] || 0;
      const lv = cnt === 0 ? '' : cnt < 3 ? 'lv1' : cnt < 6 ? 'lv2' : cnt < 10 ? 'lv3' : 'lv4';
      cells.push(`<div class="heatmap-cell ${lv}" title="${key}: ${cnt}회"></div>`);
    }
    hmEl.innerHTML = cells.join('');
  }
}

